ICAL_URL=https://calendar.google.com/calendar/ical/<calendar-id>/private-<secret>/basic.ics
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_NAME=To Do
TRELLO_LIST_NAME=Triage

# Monthly low-tide task settings
NOAA_STATION_ID=9447659
LOW_TIDE_CALENDAR_ID=

# OAuth credentials for writing Google Calendar events.
# You may set GOOGLE_OAUTH_ACCESS_TOKEN directly, or use refresh-token flow.
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# Sheet-watch task settings.
# JSON array of watched Google Sheet tabs. Each sheet must be shared as
# "Anyone with the link" (view only). Find the gid in the sheet's tab URL
# (the number after #gid=).
SHEET_WATCHERS=[{"name": "Choir Schedule", "spreadsheet_id": "<spreadsheet-id>", "gid": "0"}]

# Web-page-watch task settings.
# JSON array of plain web pages to watch for visible-text changes.
# Requires at least one of SHEET_WATCHERS or WEB_PAGE_WATCHERS to be set.
WEB_PAGE_WATCHERS=[{"name": "Competition Schedule", "url": "https://example.com/schedule.html"}]
